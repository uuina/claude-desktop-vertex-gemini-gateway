        "model": "gemini-4-argon",
        "labelOverride": "Gemini 4 Argon · GCP"
      },
      "claude-haiku-4-5": {
        "model": "gemini-4-hydrogen",
        "labelOverride": "Gemini 4 Hydrogen · GCP"
