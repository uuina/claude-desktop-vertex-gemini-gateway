+// CanFinalizeResponseStream reports whether the stream has already emitted at least one
+// complete tool_use block and has no incomplete tool call in flight, allowing a trailing
+// MALFORMED_FUNCTION_CALL or premature upstream EOF to finalize cleanly as tool_use.
+func (p *Params) CanFinalizeResponseStream() bool {
+	return p != nil && p.SawToolCall && p.ActiveToolCall == nil && !p.HasIncompleteToolCall
+}
