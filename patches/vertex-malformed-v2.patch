new file mode 100644
index 0000000..bab8734
--- /dev/null
+++ b/internal/runtime/executor/helps/vertex_malformed.go
@@ -0,0 +1,34 @@
+package helps
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"net/http"
+
+	"github.com/MoeForge/moego/ojson"
+)
+
+// VertexMalformedError is a failed generation, not a failed credential.
+// It must neither be replayed across credentials nor committed as a successful turn.
+type VertexMalformedError struct{ diagnostic string }
+
+func (e *VertexMalformedError) Error() string {
+	return "Gemini response finished with MALFORMED_FUNCTION_CALL"
+}
+func (e *VertexMalformedError) StatusCode() int       { return http.StatusBadGateway }
+func (e *VertexMalformedError) IsRequestScoped() bool { return true }
+func (e *VertexMalformedError) LogDiagnostic() string { return e.diagnostic }
+
+// VertexMalformedFunctionCall preserves only counts and SHA-256 digests in diagnostics.
+// Raw finishMessage, prompts, tool names, schemas, arguments and credentials are never logged.
+func VertexMalformedFunctionCall(response, request []byte) *VertexMalformedError {
+	for _, c := range ojson.GetBytesNoCopy(response, "candidates").Array() {
+		if c.Get("finishReason").String() != "MALFORMED_FUNCTION_CALL" {
+			continue
+		}
+		message := c.Get("finishMessage").String()
+		tools := ojson.GetBytesNoCopy(request, "tools").Raw
+		return &VertexMalformedError{diagnostic: fmt.Sprintf("finish_reason=MALFORMED_FUNCTION_CALL finish_message_bytes=%d finish_message_sha256=%x tools_sha256=%x response_parts=%d", len(message), sha256.Sum256([]byte(message)), sha256.Sum256([]byte(tools)), len(c.Get("content.parts").Array()))}
+	}
+	return nil
+}
