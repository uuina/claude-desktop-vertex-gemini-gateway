+// streamBootstrapEligible preserves terminal request failures even when a plugin
+// or validator suppressed earlier chunks before the first downstream payload.
+func streamBootstrapEligible(err error) bool {
+	var scoped coreexecutor.RequestScopedError
+	if errors.As(err, &scoped) && scoped != nil && scoped.IsRequestScoped() {
+		return false
+	}
+	status := statusFromError(err)
+	if status == 0 {
+		return true
+	}
+	switch status {
+	case http.StatusUnauthorized, http.StatusForbidden, http.StatusPaymentRequired,
+		http.StatusRequestTimeout, http.StatusTooManyRequests:
+		return true
+	default:
+		return status >= http.StatusInternalServerError
+	}
