diff --git a/sdk/api/handlers/handlers_stream_request_scoped_test.go b/sdk/api/handlers/handlers_stream_request_scoped_test.go
new file mode 100644
index 0000000..c50991a
--- /dev/null
+++ b/sdk/api/handlers/handlers_stream_request_scoped_test.go
@@ -0,0 +1,37 @@
+package handlers
+
+import (
+	"fmt"
+	"testing"
+)
+
+type bootstrapRequestScopedFixture struct {
+	status int
+	scoped bool
+}
+
+func (e bootstrapRequestScopedFixture) Error() string         { return "offline fixture" }
+func (e bootstrapRequestScopedFixture) StatusCode() int       { return e.status }
+func (e bootstrapRequestScopedFixture) IsRequestScoped() bool { return e.scoped }
+
+func TestStreamBootstrapRejectsRequestScopedError(t *testing.T) {
+	failure := bootstrapRequestScopedFixture{status: 502, scoped: true}
+	for _, err := range []error{failure, fmt.Errorf("wrapped: %w", failure)} {
+		if streamBootstrapEligible(err) {
+			t.Fatal("request-scoped error must not replay an accepted generation")
+		}
+	}
+}
+
+func TestStreamBootstrapPreservesOtherRetryStatuses(t *testing.T) {
+	for _, status := range []int{0, 401, 402, 403, 408, 429, 500, 502, 503, 504} {
+		if !streamBootstrapEligible(bootstrapRequestScopedFixture{status: status}) {
+			t.Fatalf("existing retry eligibility changed for status %d", status)
+		}
+	}
+	for _, status := range []int{400, 404, 422} {
+		if streamBootstrapEligible(bootstrapRequestScopedFixture{status: status}) {
+			t.Fatalf("unexpected retry for status %d", status)
+		}
+	}
+}
