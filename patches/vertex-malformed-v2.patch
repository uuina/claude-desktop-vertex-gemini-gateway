+++ b/internal/runtime/executor/helps/vertex_malformed_test.go
@@ -0,0 +1,26 @@
+package helps
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestVertexMalformedRequestScoped(t *testing.T) {
+	for _, raw := range []string{
+		"{\"candidates\":[{\"finishReason\":\"MALFORMED_FUNCTION_CALL\",\"finishMessage\":\"SECRET_DATA\"}]}",
+		"{\"candidates\":[{\"content\":{\"parts\":[{\"functionCall\":{\"name\":\"SECRET_TOOL\",\"args\":{}}}]},\"finishReason\":\"MALFORMED_FUNCTION_CALL\"}]}",
+	} {
+		e := VertexMalformedFunctionCall([]byte(raw), []byte("{\"tools\":[{\"secret\":\"SECRET_DATA\"}]}"))
+		if e == nil || !e.IsRequestScoped() || e.StatusCode() != 502 {
+			t.Fatalf("missing request scoped failure: %v", e)
+		}
+		if strings.Contains(e.Error()+e.LogDiagnostic(), "SECRET") {
+			t.Fatal("diagnostic leaks content")
+		}
+	}
+	for _, raw := range []string{"{}", "{\"candidates\":[{\"finishReason\":\"STOP\"}]}", "{\"error\":{\"code\":429}}", "{\"error\":{\"code\":502}}"} {
+		if VertexMalformedFunctionCall([]byte(raw), nil) != nil {
+			t.Fatal("unrelated response reclassified")
+		}
+	}
+}
